{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext"],
    "esModuleInterop": true,
    "strictNullChecks": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["node", "@types/jest"],
    "outDir": "dist",
    "rootDir": "./"
  },
  "include": ["./src/ts/**/*"],
  "exclude": ["./node_modules/**/*", "./dist/**/*", "./test/**/*"]
}
